set -eu
case "$0" in */*) pdd_launcher_path=${0%/*} ;; *) pdd_launcher_path=. ;; esac
pdd_launcher_dir=$(CDPATH= cd -P -- "$pdd_launcher_path" && pwd)
if [ ! -x "$pdd_launcher_dir/support/node" ] || [ ! -f "$pdd_launcher_dir/support/launcher/support-entry.mjs" ]; then
