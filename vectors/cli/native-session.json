        "stdinIsTTY": true
      },
      "when": {
        "call": "launchNativeSession",
        "args": {
          "agent": "codex",
          "cwd": "/home/user/project",
          "context": "# Guide\\nRead this first.",
          "request": "fix the $PATH bug && tell me",
          "selection": {
            "model": "gpt-5-codex",
            "effort": "high"
          }
        }
      },
      "expected": {
        "spawn": {
          "command": "codex",
          "shell": false,
          "argv": [
            "--no-daemon",
            "--dangerously-bypass-approvals-and-sandbox",
            "--dangerously-bypass-hook-trust",
            "-c",
            "check_for_update_on_startup=false",
            "-c",
            "projects={\"/home/user/project\"={trust_level=\"trusted\"}}",
            "-m",
            "gpt-5-codex",
            "-c",
            "model_reasoning_effort=\"high\"",
            "# Guide\\nRead this first.\\n\\nfix the $PATH bug && tell me"
          ],
          "cwd": "/home/user/project",
          "stdio": "inherit",
          "envChanged": false
        }
      }
    },
