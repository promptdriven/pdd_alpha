{
  "status": "draft",
  "prompt": "prompts/cli/argument-parser.prompt.md",
  "story": "story/cli/ARGUMENT-PARSER.md",
  "cases": [
    {"id": "session-no-options", "criteria": ["AC1"], "input": ["session"], "expected": {"commandId": "session", "local": "session", "operands": [], "options": {}}, "effects": ["options has no --agent key; the parser applies no default", "plan has no workflowName field"]},
    {"id": "session-agent-and-request-words", "criteria": ["AC1", "AC5"], "input": ["session", "--agent", "claude", "Draft", "a", "prompt"], "expected": {"commandId": "session", "local": "session", "operands": ["Draft", "a", "prompt"], "options": {"--agent": "claude"}}},
    {"id": "recipe-shortcut-workflow-name", "criteria": ["AC1"], "input": ["workflow", "small-change", "--agent", "codex"], "expected": {"commandId": "workflow.small-change", "local": "session", "workflowName": "small-change", "operands": [], "options": {"--agent": "codex"}}},
    {"id": "recipe-shortcut-custom-name-refused", "criteria": ["AC1", "AC4"], "given": "my-team is a safe name but not a catalogued recipe shortcut.", "input": ["workflow", "my-team"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "root-help-empty", "criteria": ["AC2"], "input": [], "expected": {"commandId": "help", "local": "help", "helpPrefix": []}, "effects": ["plan has no operands or options field"]},
    {"id": "group-help-short-flag", "criteria": ["AC2"], "input": ["workflow", "-h"], "expected": {"commandId": "help", "local": "help", "helpPrefix": ["workflow"]}},
    {"id": "help-word-exact-command", "criteria": ["AC2"], "input": ["help", "workflow", "run"], "expected": {"commandId": "help", "local": "help", "helpPrefix": ["workflow", "run"]}},
    {"id": "help-flag-after-valid-arguments", "criteria": ["AC2", "AC3"], "input": ["workflow", "resume", "a1234567-1234-4123-8123-123456789abc", "--decision", "approve", "--help"], "expected": {"commandId": "help", "local": "help", "helpPrefix": ["workflow", "resume"]}, "effects": ["helpPrefix holds the route prefix only, not the run ID or decision"]},
    {"id": "help-flag-invalid-value-refused", "criteria": ["AC3", "AC5"], "input": ["session", "--agent", "other", "--help"], "expectedError": {"class": "CommandInputError", "exitCode": 2}, "effects": ["no help plan"]},
    {"id": "help-flag-incomplete-operands-refused", "criteria": ["AC3"], "given": "workflow run requires NAME and ISSUE; ISSUE is missing.", "input": ["workflow", "run", "feature", "--help"], "expectedError": {"class": "CommandInputError", "exitCode": 2}, "effects": ["no help plan"]},
    {"id": "unknown-command-with-help-refused", "criteria": ["AC3"], "input": ["deploy", "--help"], "expectedError": {"class": "CommandInputError", "exitCode": 2}, "effects": ["no help plan"]},
    {"id": "run-custom-name-url-issue", "criteria": ["AC4"], "given": "my-team-workflow is not a bundled name.", "input": ["workflow", "run", "my-team-workflow", "https://github.com/octo/repo/issues/12/"], "expected": {"commandId": "workflow.run", "local": "workflow-run", "operands": ["my-team-workflow", "https://github.com/octo/repo/issues/12/"], "options": {}}},
    {"id": "run-options-before-operands", "criteria": ["AC4", "AC5"], "input": ["workflow", "run", "--agent", "claude", "feature", "octo/repo.js#7"], "expected": {"commandId": "workflow.run", "operands": ["feature", "octo/repo.js#7"], "options": {"--agent": "claude"}}},
    {"id": "run-name-64-characters", "criteria": ["AC4"], "input": ["workflow", "run", "team-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "42"], "expected": {"commandId": "workflow.run", "operands": ["team-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "42"], "options": {}}},
    {"id": "run-name-65-characters-refused", "criteria": ["AC4"], "input": ["workflow", "run", "team-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", "42"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "run-issue-zero-refused", "criteria": ["AC4"], "input": ["workflow", "run", "feature", "0"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "resume-without-decision", "criteria": ["AC4"], "input": ["workflow", "resume", "a1234567-1234-4123-8123-123456789abc"], "expected": {"commandId": "workflow.resume", "local": "workflow-resume", "operands": ["a1234567-1234-4123-8123-123456789abc"], "options": {}}, "effects": ["options has no --decision key"]},
    {"id": "resume-uppercase-uuid-kept", "criteria": ["AC4"], "input": ["workflow", "resume", "A1234567-1234-4123-8123-123456789ABC"], "expected": {"commandId": "workflow.resume", "operands": ["A1234567-1234-4123-8123-123456789ABC"], "options": {}}, "effects": ["the run ID keeps its uppercase letters"]},
    {"id": "resume-version-1-uuid-refused", "criteria": ["AC4"], "input": ["workflow", "resume", "a1234567-1234-1123-8123-123456789abc"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "attach-option-refused", "criteria": ["AC4", "AC5"], "given": "workflow attach declares no options.", "input": ["workflow", "attach", "a1234567-1234-4123-8123-123456789abc", "--agent", "codex"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "list-json-flag-true", "criteria": ["AC1", "AC5"], "input": ["workflow", "list", "--json"], "expected": {"commandId": "workflow.list", "local": "workflow-list", "operands": [], "options": {"--json": true}}},
    {"id": "list-json-repeated-refused", "criteria": ["AC5"], "input": ["workflow", "list", "--json", "--json"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "option-equals-form-refused", "criteria": ["AC5"], "input": ["session", "--agent=claude"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "literal-marker-keeps-flag-like-text", "criteria": ["AC6"], "input": ["workflow", "feature", "--agent", "claude", "--", "--dangerously-skip-permissions", "--", "--help"], "expected": {"commandId": "workflow.feature", "local": "session", "workflowName": "feature", "operands": ["--dangerously-skip-permissions", "--", "--help"], "options": {"--agent": "claude"}}, "effects": ["not a help plan", "the first -- is not an operand"]},
    {"id": "marker-on-non-session-route-refused", "criteria": ["AC6"], "input": ["completion", "--", "bash"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "native-flag-before-marker-refused", "criteria": ["AC6"], "input": ["session", "--dangerously-skip-permissions"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "nul-in-word-refused", "criteria": ["AC7"], "input": ["session", "a\u0000b"], "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "non-array-refused", "criteria": ["AC7"], "given": "argv is one string, not an array.", "input": "session", "expectedError": {"class": "CommandInputError", "exitCode": 2}},
    {"id": "refusal-does-not-echo-input", "criteria": ["AC7"], "input": ["zz-unknown-word-417"], "expectedError": {"class": "CommandInputError", "exitCode": 2}, "effects": ["the error message does not contain zz-unknown-word-417"]},
    {"id": "caller-array-unchanged-and-plan-frozen", "criteria": ["AC8"], "input": ["session", "--agent", "claude", "hi"], "expected": {"commandId": "session", "operands": ["hi"], "options": {"--agent": "claude"}}, "effects": ["the caller's array equals its original value after the call", "the plan, its operands and its options are frozen", "a later change to the caller's array does not change the plan"]}
  ]
}
